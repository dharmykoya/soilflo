NODE_ENV=development
PORT=3000

# PostgreSQL — resolved via docker-compose service name
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=soilflo
POSTGRES_PASSWORD=soilflo
POSTGRES_DB=soilflo

# Redis — resolved via docker-compose service name
REDIS_HOST=redis
REDIS_PORT=6379

# Feature flags
QUEUE_ENABLED=false
