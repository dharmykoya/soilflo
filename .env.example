NODE_ENV=development
PORT=3000

# PostgreSQL — local instance or infrastructure-only docker-compose
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=soilflo
POSTGRES_PASSWORD=soilflo
POSTGRES_DB=soilflo

# Redis — BullMQ stub, not required unless QUEUE_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# Feature flags
QUEUE_ENABLED=false
